[Unit]
Description=Local AI image generation web UI
After=network.target comfyui.service
Wants=comfyui.service

[Service]
Type=simple
User=%i
# %h expands to /root for system units, so spell the home out as /home/%i
WorkingDirectory=/home/%i/thanipitak-agent
Environment=COMFY_HOME=/home/%i/ComfyUI
Environment=COMFY_URL=http://127.0.0.1:8188
Environment=DRAW_HOST=127.0.0.1
Environment=DRAW_PORT=8190
Environment=ENRICHER_URL=http://127.0.0.1:11434/v1/chat/completions
Environment=ENRICHER_MODEL=hf.co/typhoon-ai/typhoon2.5-qwen3-4b-gguf:Q4_K_M
ExecStart=/usr/bin/python3 /home/%i/thanipitak-agent/draw_server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
